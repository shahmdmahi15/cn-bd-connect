# ==============================================================================
# CN-BD Connect Environment Configuration
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_pass_888
POSTGRES_DB=cn_bd_connect
DATABASE_URL=postgresql://postgres:postgres_secure_pass_888@postgres:5432/cn_bd_connect?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Authentication & Security
JWT_SECRET=cn_bd_connect_jwt_secret_token_999
JWT_EXPIRES_IN=30d

# Coturn Hong Kong WebRTC Relay
COTURN_DOMAIN=cn-bd-connect-turn.dpdns.org
COTURN_AUTH_SECRET=cn-bd-connect-coturn-shared-secret-key-999
COTURN_TTL_SECONDS=86400

# Next.js Frontend & API Endpoints
NEXT_PUBLIC_API_URL=https://cn-bd-connect-api.shahmdmahi.dpdns.org
NEXT_PUBLIC_SOCKET_URL=https://cn-bd-connect-api.shahmdmahi.dpdns.org
INTERNAL_API_URL=http://api:3001

# Let's Encrypt Certbot
CERTBOT_EMAIL=admin@shahmdmahi.dpdns.org
CERTBOT_STAGING=0
